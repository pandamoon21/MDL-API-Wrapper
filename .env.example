# --- API key (OPTIONAL) ---
# mdl-api-key is NOT a secret — it's a client nonce the MDL app generates per
# launch (20 chars, [a-zA-Z0-9]), and the server never validates it. If unset,
# mdlaw generates one for you. You may pin a value for reproducible requests,
# but it carries no security meaning.
MDL_API_KEY=

# --- Transport (optional) ---
# httpx (default): plain TLS stack. Passes from most residential IPs.
# curl_cffi: browser/mobile TLS impersonation — use this if Cloudflare serves
# you a "403 Just a moment..." challenge (e.g. from datacenter IPs).
#   pip install curl_cffi
MDL_TRANSPORT=httpx

# --- Account (auth-gated endpoints: title detail, watchlist, search, /me) ---
# Set BOTH to enable authenticated requests. The wrapper logs in once and
# auto-refreshes the token. 2FA is NOT supported — disable it on this account
# or use an app password.
MDL_USERNAME=
MDL_PASSWORD=

# --- Response cache ---
# Backend: memory (default, in-memory TTL) | sqlite | mysql | postgres
MDL_CACHE_BACKEND=memory
# Required when MDL_CACHE_BACKEND is not memory:
#   sqlite:    sqlite:///mdlaw_cache.db          (file next to the app)
#   mysql:     mysql://user:***@host:3306/dbname
#   postgres:  postgresql://user:***@host:5432/dbname
MDL_CACHE_DB_URL=
